<%- include('partials/head') %>

<%- include('partials/nav') %>

<section class="page-head">
  <div class="container">
    <p class="eyebrow">Download Links</p>
    <h1>Credentials &amp; Certifications</h1>
    <p class="section-sub">The certifications and degrees behind the reviewer.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="cert-grid">
      <% certifications.forEach(function (c) { %>
        <div class="card cert-card">
          <span class="cert-badge">🎓</span>
          <h3><%= c.name %></h3>
          <p class="muted">Issued by <%= c.issuer %></p>
          <a href="/contact" class="btn btn-outline btn-sm">Request verification</a>
        </div>
      <% }); %>
    </div>
    <div class="card cert-links">
      <h3>Public links</h3>
      <ul class="bullets">
        <li><a href="/resume">Full résumé — view online</a></li>
        <li><a href="mailto:<%= CONTACT_EMAIL %>?subject=R%C3%A9sum%C3%A9%20copy%20request">Email for a PDF copy of the résumé or degree certificates</a></li>
        <li><a href="https://github.com/StephanFWard" target="_blank" rel="noopener">Public GitHub ↗</a></li>
      </ul>
    </div>
  </div>
</section>

<%- include('partials/footer') %>

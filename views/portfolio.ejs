<%- include('partials/head') %>

<%- include('partials/nav') %>

<section class="page-head">
  <div class="container">
    <p class="eyebrow">Portfolio</p>
    <h1>Projects &amp; builds</h1>
    <p class="section-sub">From community crypto and nonprofit AI governance to marketplace apps and enterprise Rails platforms.</p>
  </div>
</section>

<section class="section">
  <div class="container">
    <div class="feature-grid portfolio-grid">
      <% projects.forEach(function (p, i) { %>
        <article class="card project-card project-card--<%= i %>">
          <div class="project-top">
            <span class="project-icon"><%= p.icon %></span>
            <span class="pill pill-blue"><%= p.period %></span>
          </div>
          <h3>
            <% if (p.url) { %><a class="project-name-link" href="<%= p.url %>" target="_blank" rel="noopener"><%= p.name %> ↗</a><% } else { %><%= p.name %><% } %>
          </h3>
          <p class="muted project-kind"><%= p.kind %><% if (typeof p.role !== 'undefined' && p.role) { %> · <%= p.role %><% } %></p>
          <p><%= p.summary %></p>
          <div class="kw-cloud">
            <% p.highlights.forEach(function (h) { %><span class="pill pill-green"><%= h %></span><% }); %>
          </div>
          <% if (p.url) { %>
          <p class="project-visit"><a class="chip-link chip-link-sm" href="<%= p.url %>" target="_blank" rel="noopener">Visit live site ↗</a></p>
          <% } %>
        </article>
      <% }); %>
    </div>
  </div>
</section>

<%- include('partials/footer') %>
